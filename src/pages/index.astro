---
import "@/styles/global.scss";
import Header from "@components/Header.astro";
import { SITE_DESCRIPTION, SITE_FAVICON, SITE_HOME, SITE_LANGUAGE, SITE_TAB, SITE_TITLE } from "@config";
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <Header title={SITE_TITLE} description={SITE_DESCRIPTION} favicon={SITE_FAVICON} />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${SITE_TAB} 首页`}><span class="wordmark-dot" aria-hidden="true"></span>{SITE_TAB}</a>
        <span class="header-label">PERSONAL JOURNAL</span>
      </header>

      <main id="content" class="intro">
        <div class="intro-content">
          <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{SITE_HOME.eyebrow}</p>
          <h1>{SITE_HOME.title}</h1>
          <p class="description">{SITE_HOME.description}</p>
          <nav class="actions" aria-label="开始浏览">
            <a class="primary-link" href={SITE_HOME.primary.href}>
              {SITE_HOME.primary.text}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </nav>
        </div>
        <div class="intro-mark" aria-hidden="true">K<span>.</span></div>
      </main>

      <footer class="site-footer"><span>{SITE_HOME.footer}</span><span>© {new Date().getFullYear()} {SITE_TITLE}</span></footer>
    </div>
  </body>
</html>

<style>
  :global(html) { background: #f6f4ef; }
  :global(body) { margin: 0; color: #20251f; font-family: "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  .skip-link { position: absolute; z-index: 10; top: -4rem; left: 1rem; padding: .65rem 1rem; background: #20251f; color: white; }
  .skip-link:focus { top: 1rem; }
  .page-shell { min-height: 100svh; max-width: 1440px; margin: auto; padding: clamp(1.25rem, 4vw, 3.5rem) clamp(1.5rem, 7vw, 7rem); display: flex; flex-direction: column; }
  .site-header, .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .wordmark { display: inline-flex; align-items: center; gap: .7rem; color: inherit; font-size: .95rem; font-weight: 700; text-decoration: none; }
  .wordmark-dot { width: .65rem; height: .65rem; border-radius: 50%; background: #ad6947; }
  .header-label, .eyebrow, .site-footer { color: #777c73; font-size: .72rem; letter-spacing: .13em; }
  .intro { position: relative; flex: 1; display: flex; align-items: center; padding: 5rem 0; }
  .intro-content { position: relative; z-index: 1; max-width: 710px; }
  .eyebrow { display: flex; align-items: center; gap: .9rem; margin: 0 0 2rem; color: #976044; font-weight: 700; letter-spacing: .2em; }
  .eyebrow-line { width: 2rem; height: 1px; background: currentColor; }
  h1 { max-width: 12em; margin: 0; font-family: "Noto Serif SC", "Songti SC", "SimSun", serif; font-size: clamp(3rem, 7vw, 6.5rem); font-weight: 600; line-height: 1.2; letter-spacing: -.045em; }
  .description { max-width: 34rem; margin: 2rem 0 0; color: #666d64; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 2; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; margin-top: 3rem; }
  .primary-link { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 3.5rem; font-size: .95rem; font-weight: 600; text-decoration: none; transition: transform .2s ease, background-color .2s ease; }
  .primary-link { padding: .8rem 1.4rem; border-radius: .3rem; background: #283d32; color: #fff; }
  .primary-link:hover { background: #385645; transform: translateY(-2px); }
  .primary-link svg { width: 1.2rem; height: 1.2rem; }
  .primary-link:focus-visible, .wordmark:focus-visible { outline: 3px solid #ad6947; outline-offset: 4px; }
  .intro-mark { position: absolute; right: 0; bottom: 3%; color: #e9e6dc; font-family: Georgia, serif; font-size: clamp(12rem, 35vw, 32rem); line-height: 1; user-select: none; }
  .intro-mark span { color: #e4d7cb; }
  .site-footer { padding-top: 1.5rem; border-top: 1px solid #deded5; letter-spacing: .02em; }
  @media (max-width: 640px) { .header-label { display: none; } .intro { padding: 5rem 0 7rem; } .intro-mark { right: -1rem; bottom: 4rem; opacity: .5; } .site-footer { align-items: flex-start; flex-direction: column; gap: .45rem; } }
  @media (prefers-reduced-motion: reduce) { .primary-link { transition: none; } }
</style>
